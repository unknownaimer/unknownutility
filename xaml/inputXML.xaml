<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="unknowntweaks" Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#D4D4D4"
        FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg0" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Bg1" Color="#252526"/>
    <SolidColorBrush x:Key="Bg2" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Bg3" Color="#3E3E42"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="Fg" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="FgDim" Color="#858585"/>
    <SolidColorBrush x:Key="Accent" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1C97EA"/>
    <SolidColorBrush x:Key="Green" Color="#4EC9B0"/>
    <SolidColorBrush x:Key="Orange" Color="#CE9178"/>
    <SolidColorBrush x:Key="Yellow" Color="#DCDCAA"/>
    <SolidColorBrush x:Key="Red" Color="#F14C4C"/>
    <SolidColorBrush x:Key="Blue" Color="#569CD6"/>
    <SolidColorBrush x:Key="Purple" Color="#C586C0"/>
    <SolidColorBrush x:Key="ScrollTrack" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#424242"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4F4F4F"/>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>

    <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Opacity="0.7" RenderOptions.CachingHint="Cache">
      <DrawingBrush.Drawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="0,15.5" EndPoint="16,15.5"/>
              <LineGeometry StartPoint="15.5,0" EndPoint="15.5,16"/>
            </GeometryGroup>
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Pen>
            <Pen Brush="#2A2A2E" Thickness="1"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bd" Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Rectangle Fill="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="VScrollBarTemplate" TargetType="ScrollBar">
      <Grid Background="{DynamicResource ScrollTrack}" Width="8">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
          </Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}"/></Track.Thumb>
        </Track>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HScrollBarTemplate" TargetType="ScrollBar">
      <Grid Background="{DynamicResource ScrollTrack}" Height="8">
        <Track x:Name="PART_Track" IsDirectionReversed="False">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
          </Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}"/></Track.Thumb>
        </Track>
      </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template" Value="{StaticResource VScrollBarTemplate}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template" Value="{StaticResource HScrollBarTemplate}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Orientation="Vertical"
                         Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
              <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                         Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                         ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="8,4,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                      BorderBrush="{DynamicResource FgDim}" Background="{DynamicResource Bg2}" VerticalAlignment="Top" Margin="0,1,0,0" SnapsToDevicePixels="True">
                <Path x:Name="Mark" Data="M 3,8 L 7,12 L 13,4" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Stretch="None"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Margin="6,0,0,0" KeyboardNavigation.TabIndex="1"/>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource Bg0}" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Root" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Cursor="Hand" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource Bg1}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg2}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg0}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="MaxWidth" Value="560"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="8,5" CornerRadius="3">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style x:Key="GraphCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Bg1}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Margin" Value="8,8,8,0"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="8,16,0,4"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="8,2,8,4"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="8,4,8,4"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#0E639C" Height="24">
      <DockPanel>
        <TextBlock Name="VersionText" DockPanel.Dock="Right" Text="" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
        <TextBlock Name="TikTokLink" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0" FontSize="11"><Hyperlink Name="TikTokHyperlink" Foreground="White">tiktok @aimerunknown</Hyperlink></TextBlock>
        <TextBlock Name="SupportLink" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0" FontSize="11"><Hyperlink Name="SupportHyperlink" Foreground="White">discord support</Hyperlink></TextBlock>
        <TextBlock Name="CreditText" DockPanel.Dock="Right" Text="" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
        <TextBlock Name="StatusText" Text="starting..." Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="200" MinHeight="80"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" MinWidth="240"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252526">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Name="LeftPanel" Margin="0,0,0,8">
              <Border Margin="8,10,8,0" Padding="8,4">
                <StackPanel>
                  <TextBlock Text="unknowntweaks" FontSize="18" FontWeight="Bold" Foreground="#4EC9B0"/>
                  <TextBlock Text="free, open source, undoable" Foreground="#858585" FontSize="11"/>
                </StackPanel>
              </Border>
              <StackPanel Name="GraphPanel"/>
              <Border Style="{StaticResource GraphCard}">
                <StackPanel>
                  <TextBlock Text="GAME" Foreground="#858585" FontSize="12"/>
                  <TextBlock Name="GameText" Text="no fullscreen game detected" Foreground="#DCDCAA" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock Name="GameDetailText" Text="" Foreground="#858585" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  <TextBlock Name="PingText" Text="router --  internet --" Foreground="#D4D4D4" Margin="0,8,0,0"/>
                  <TextBlock Name="RegionText" Text="best Fortnite region: not measured yet" Foreground="#D4D4D4" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  <TextBlock Name="LinkText" Text="" Foreground="#858585" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Name="BtnPingRegionsSide" Content="ping regions" Padding="8,3" FontSize="11"/>
                    <Button Name="BtnBoostGame" Content="boost game priority" Padding="8,3" FontSize="11" ToolTip="Sets the foreground game process to High priority for this session. Anti-cheat protected games (Fortnite, Valorant) refuse this; use the registry tweak in the Risky section for Fortnite instead."/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <TabControl Grid.Column="2" Name="Tabs">
          <TabItem Header="TWEAKS">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="BtnUndoAll" Content="Undo everything" Style="{StaticResource DangerButton}" ToolTip="Reverts every tweak unknowntweaks has ever applied on this PC, using the snapshots it took, even from an earlier session."/>
                    <Button Name="BtnUndo" Content="Undo selected"/>
                    <Button Name="BtnApply" Content="Apply selected" Style="{StaticResource AccentButton}" Margin="0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Name="BtnRecommended" Content="Select recommended"/>
                    <Button Name="BtnClearTweaks" Content="Clear"/>
                    <Button Name="BtnExportSel" Content="Export" ToolTip="Saves the ticked tweaks, the Fortnite and VALORANT profiles and the launch arguments to a small JSON file you can share. No machine facts, no snapshots."/>
                    <Button Name="BtnImportSel" Content="Import" ToolTip="Loads a selection file: ticks the boxes and picks the profiles. Nothing is applied until you press Apply selected."/>
                    <CheckBox Name="ChkRestorePoint" Content="create a restore point first" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Name="TweaksPanel" Margin="8,4,8,16"/>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <TabItem Header="SYSTEM">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,4,8,16">
                <TextBlock Text="This PC" Style="{StaticResource SectionHeader}"/>
                <TextBlock Name="SysTierText" Style="{StaticResource Body}" Text=""/>
                <StackPanel Orientation="Horizontal" Margin="8,6,0,4">
                  <Button Name="BtnBenchmark" Content="Run benchmark (10 s)" Style="{StaticResource AccentButton}" ToolTip="CPU single core and all cores, memory copy, and the system disk read and written with the Windows cache bypassed. Synthetic and relative: 100 is the machine the tool was calibrated on (Ryzen 7 5800XT, DDR4, NVMe). It shows where this PC is CPU-bound or disk-bound; it is not a game benchmark and it does not change anything."/>
                  <Button Name="BtnRecommendForPc" Content="Recommend for this PC" ToolTip="Reads the hardware facts (memory integrity and VBS state, laptop or desktop, disk type, GPU, CPU, Windows build) and the last benchmark, and lists the tweaks that apply here with the reason for each. Risky ones are named with their cost and are never ticked for you."/>
                  <Button Name="BtnRecommendTick" Content="Tick them in TWEAKS" ToolTip="Ticks the safe and optional recommendations in the TWEAKS tab. Apply is still a separate step there."/>
                </StackPanel>
                <TextBox Name="BenchBox" IsReadOnly="True" Height="118" Margin="8,0,8,0" Text="not run yet" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Recommended on this PC" Style="{StaticResource SectionHeader}"/>
                <StackPanel Name="RecommendPanel"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="FORTNITE">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,4,8,16">
                <TextBlock Text="Fortnite" Style="{StaticResource SectionHeader}"/>
                <TextBlock Name="FnStatusText" Style="{StaticResource Body}" Text="detecting..."/>
                <TextBlock Text="Video settings profile (GameUserSettings.ini)" Style="{StaticResource SectionHeader}"/>
                <ListBox Name="FnProfileList" Margin="8,4,8,4" Height="96"/>
                <TextBlock Name="FnProfileDesc" Style="{StaticResource Dim}" Text=""/>
                <StackPanel Name="FnHiddenPanel"/>
                <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                  <Button Name="BtnFnApply" Content="Apply profile" Style="{StaticResource AccentButton}" ToolTip="Writes only keys the in-game Video menu exposes, merged into your existing GameUserSettings.ini with a backup taken first. Engine.ini, Scalability.ini and fog/foliage cvars are never touched: Fortnite has ignored them since 2017 and FNCS rule 8.2.1 treats them as modifying the client."/>
                  <Button Name="BtnFnRestore" Content="Restore original file"/>
                  <Button Name="BtnFnLock" Content="Lock (read-only)"/>
                  <Button Name="BtnFnUnlock" Content="Unlock"/>
                  <Button Name="BtnFnShaderCache" Content="Clear shader caches"/>
                </StackPanel>
                <TextBlock Text="Launch arguments (Epic Games Launcher)" Style="{StaticResource SectionHeader}" ToolTip="Written into the Epic Games Launcher's own settings file; the launcher is closed and restarted for that. Only arguments the Unreal engine actually parses on a client are offered."/>
                <StackPanel Name="FnArgsPanel"/>
                <DockPanel Margin="8,6,8,0">
                  <TextBlock Text="extra: " VerticalAlignment="Center" Foreground="#858585"/>
                  <TextBox Name="FnArgsExtra" Text="" ToolTip="Anything else you want appended, e.g. -ResX=1920 -ResY=1080"/>
                </DockPanel>
                <TextBlock Name="FnArgsPreview" Style="{StaticResource Body}" Foreground="#DCDCAA" Text=""/>
                <StackPanel Orientation="Horizontal" Margin="8,6,0,0">
                  <Button Name="BtnFnArgsApply" Content="Write launch arguments" Style="{StaticResource AccentButton}"/>
                  <Button Name="BtnFnArgsClear" Content="Clear launch arguments"/>
                  <Button Name="BtnFnProbe" Content="Probe launcher key"/>
                  <Button Name="BtnFnProbeDone" Content="Finish probe"/>
                </StackPanel>
                <TextBlock Text="NVIDIA driver profile (experimental)" Style="{StaticResource SectionHeader}" ToolTip="Writes into the driver's own settings database through NVAPI - the same one NVIDIA Control Panel and Profile Inspector write - so nothing is downloaded and no third-party tool runs. Only the settings listed in the preset are touched, and Restore puts every one of them back to the driver default. No game file is changed and nothing is injected. Needs an NVIDIA GPU; AMD and Intel expose their own equivalents in their control panels."/>
                <TextBlock Name="NvProfileStatusText" Style="{StaticResource Body}" Text="reading driver profile..."/>
                <ListBox Name="NvProfileList" Margin="8,4,8,4" Height="52"/>
                <TextBlock Name="NvProfileDesc" Style="{StaticResource Dim}" Text=""/>
                <StackPanel Orientation="Horizontal" Margin="8,6,0,0">
                  <Button Name="BtnNvProfileApply" Content="Apply driver profile" Style="{StaticResource AccentButton}" ToolTip="Restart Fortnite afterwards for the driver to pick it up. The Potato preset's LOD bias only applies on DirectX 11, so tick the -high -d3d11 launch argument above as well or it will do nothing."/>
                  <Button Name="BtnNvProfileRestore" Content="Restore driver defaults" ToolTip="Puts every setting this tool can write back to the NVIDIA default for Fortnite. Anything you set yourself in NVIDIA Control Panel for other applications is untouched."/>
                  <Button Name="BtnNvProfileRefresh" Content="Refresh"/>
                </StackPanel>
                <TextBlock Text="Live status (Epic)" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
                  <Button Name="BtnFnLiveStatus" Content="Check Epic status" ToolTip="Asks status.epicgames.com through its public API: every Fortnite service, open incidents with Epic's latest update, and scheduled maintenance. So you know whether a problem is on Epic's side before you touch anything. The known gameplay bugs list is a web page; the result links it."/>
                </StackPanel>
                <TextBox Name="FnLiveStatusBox" IsReadOnly="True" Height="150" Margin="8,0,8,0" Text="not checked yet" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="VALORANT">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,4,8,16">
                <TextBlock Text="VALORANT" Style="{StaticResource SectionHeader}"/>
                <TextBlock Name="VaStatusText" Style="{StaticResource Body}" Text="detecting..."/>
                <TextBlock Text="Settings profile" Style="{StaticResource SectionHeader}" ToolTip="Resolution, VSync, frame cap and letterboxing are Unreal settings in GameUserSettings.ini; the quality groups the Video menu shows are Riot's own keys in RiotUserSettings.ini. Both are per-player user settings that Riot documents as editable; Vanguard cares about code injected into the game, not about these files. Both are backed up before the first write."/>
                <ListBox Name="VaProfileList" Margin="8,4,8,4" Height="72"/>
                <TextBlock Name="VaProfileDesc" Style="{StaticResource Dim}" Text=""/>
                <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                  <Button Name="BtnVaApply" Content="Apply profile" Style="{StaticResource AccentButton}" ToolTip="Key-level merge into the active player's files while VALORANT is closed (the game rewrites them on exit; the Riot client in the tray does not touch them). If the game later shows different values, Riot's roaming settings won the sync; apply again with the game closed."/>
                  <Button Name="BtnVaRestore" Content="Restore original files"/>
                  <Button Name="BtnVaLaunch" Content="Launch VALORANT" ToolTip="Starts the game through the Riot client, the same way its shortcut does."/>
                  <Button Name="BtnVaShaderCache" Content="Clear shader caches" ToolTip="Deletes the NVIDIA or AMD driver shader caches. The first launch afterwards stutters while they rebuild; a stutter fix, not a boost."/>
                  <Button Name="BtnVaRefresh" Content="Refresh"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="STRETCHED">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,4,8,16">
                <TextBlock Text="True stretched resolution" Style="{StaticResource SectionHeader}" ToolTip="True stretched means the display mode itself changes and the GPU scaler fills the screen, so the game renders fewer pixels and nothing is letterboxed. This tab creates the mode through the NVIDIA driver's own API when Windows does not already offer it, switches the desktop, sets Windows display scaling to Stretched (the SetDisplayConfig API, saved for that mode), writes the game's resolution, launches it, and puts everything back when it closes. If your GPU still shows black bars, set Full-screen scaling once in its control panel (NVIDIA: Adjust desktop size and position > Full-screen, perform scaling on GPU); that is a per-driver setting no app can force for every vendor. VALORANT locks fullscreen to the monitor's native aspect ratio, so for it the monitor device is disabled while the game runs and re-enabled afterwards."/>
                <TextBlock Name="StretchStatusText" Style="{StaticResource Body}" Text="reading display..."/>
                <Grid Margin="8,4,8,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ListBox Name="StretchPresetList" Grid.Column="0" Height="130"/>
                  <ListBox Name="StretchGameList" Grid.Column="1" Height="130" Margin="8,0,0,0"/>
                </Grid>
                <DockPanel Margin="8,6,8,0">
                  <TextBlock Text="custom: " VerticalAlignment="Center" Foreground="#858585"/>
                  <TextBox Name="StretchCustom" Text="" ToolTip="Any width x height, for example 1560x1080. When filled in it replaces the preset."/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                  <Button Name="BtnStretchStart" Content="Switch and launch" Style="{StaticResource AccentButton}" ToolTip="Records the current mode and scaling, makes sure the mode exists, sets scaling to Stretched, writes the game's resolution, switches the desktop and launches the game. When the game closes the desktop is restored. If the tool is closed or crashes before that, the next start restores it."/>
                  <Button Name="BtnStretchRestore" Content="Restore desktop" Style="{StaticResource DangerButton}" ToolTip="Puts the desktop mode, the scaling and the monitor device back from the recorded state, at any time."/>
                  <Button Name="BtnStretchAddMode" Content="Create custom mode only" ToolTip="Only creates the selected mode through the NVIDIA driver API (the same thing NVIDIA Control Panel's Customize dialog does), without switching to it."/>
                  <Button Name="BtnStretchRefresh" Content="Refresh"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="GAME READY">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="BtnGameReadyClose" Content="Close selected" Style="{StaticResource DangerButton}" Margin="0" ToolTip="Asks each ticked window to close, waits three seconds, then ends whatever is still running. Frees CPU time and memory for the game. Nothing here can be undone; unsaved work in those apps is lost, and you start them again yourself."/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Name="BtnGameReadyRefresh" Content="Refresh"/>
                    <Button Name="BtnGameReadyClear" Content="Clear"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,4,8,16">
                  <TextBlock Text="Game you are about to play" Style="{StaticResource SectionHeader}" ToolTip="The game and its launcher are left alone. Windows itself, the security stack, audio, the GPU display containers and every anti-cheat are never listed at all: that list is code, not config."/>
                  <ListBox Name="GameReadyGameList" Margin="8,4,8,4" Height="72"/>
                  <TextBlock Text="Running in your session" Style="{StaticResource SectionHeader}" ToolTip="Voice chat, recording and peripheral software are listed but not ticked; everything else is ticked. Hover an entry for what it is."/>
                  <StackPanel Name="GameReadyPanel"/>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <TabItem Header="NETWORK">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,4,8,16">
                <TextBlock Text="Fortnite region ping" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
                  <Button Name="BtnPingRegions" Content="Ping regions now" Style="{StaticResource AccentButton}" ToolTip="Pings Epic's own datacenter hosts, the same ones the in-game region list measures. Pick the region with the lowest average and low jitter in Fortnite under Settings > Game > Matchmaking Region. A script cannot lower in-match ping the way ExitLag-style relays do: after your router the route is your ISP's. What does help for free is a cable instead of Wi-Fi and fixing bufferbloat on the router."/>
                  <Button Name="BtnTracert" Content="Traceroute to best region"/>
                </StackPanel>
                <TextBox Name="RegionBox" IsReadOnly="True" Height="210" Margin="8,0,8,0" Text="not measured yet" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="DNS resolver" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
                  <Button Name="BtnDnsBench" Content="Benchmark resolvers" ToolTip="Sends uncached queries with a real timeout to each resolver from your connection. DNS affects the launcher, login, matchmaking API and patch downloads only; it never changes in-match ping."/>
                  <Button Name="BtnDnsSet" Content="Use selected resolver" Style="{StaticResource AccentButton}"/>
                  <Button Name="BtnDnsReset" Content="Back to automatic / previous"/>
                </StackPanel>
                <Grid Margin="8,0,8,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ListBox Name="DnsList" Grid.Column="0" Height="190"/>
                  <TextBox Name="DnsBox" Grid.Column="1" IsReadOnly="True" Height="190" Margin="8,0,0,0" Text="not measured yet" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Grid>
                <TextBlock Text="Tools" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
                  <Button Name="BtnLinkInfo" Content="Link info"/>
                  <Button Name="BtnFlushDns" Content="Flush DNS cache"/>
                  <Button Name="BtnNetReset" Content="Reset network stack (repair)" Style="{StaticResource DangerButton}" ToolTip="netsh winsock reset + netsh int ip reset. Fixes broken stacks; also wipes static IP/DNS and per-interface tweaks. Needs a reboot."/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="APPS">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="BtnInstall" Content="Install selected" Style="{StaticResource AccentButton}" Margin="0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Name="BtnAppsClear" Content="Clear"/>
                    <TextBlock Text="installed silently with winget" Foreground="#858585" VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Name="AppsPanel" Margin="8,4,8,16"/>
              </ScrollViewer>
            </DockPanel>
          </TabItem>


          <TabItem Header="STARTUP">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="BtnStartupDisable" Content="Disable selected" Style="{StaticResource AccentButton}" Margin="0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Name="BtnStartupEnable" Content="Enable selected"/>
                    <Button Name="BtnStartupRefresh" Content="Refresh"/>
                    <Button Name="BtnStartupClear" Content="Clear"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,4,8,16">
                  <StackPanel Name="StartupPanel"/>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <TabItem Header="DEBLOAT">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="BtnDebloatRemove" Content="Remove selected" Style="{StaticResource DangerButton}" Margin="0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Name="BtnDebloatRecommended" Content="Select recommended"/>
                    <Button Name="BtnDebloatClear" Content="Clear"/>
                    <CheckBox Name="ChkDeprovision" Content="also for new accounts" IsChecked="True" VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="Also deprovision the package so a new user account, or a Windows feature update, does not put it back."/>
                    <TextBlock Text="uninstalls apps: NOT undoable from a snapshot" Foreground="#DCDCAA" VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,4,8,16">
                  <StackPanel Name="DebloatPanel"/>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>
          <TabItem Header="INFO">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel Orientation="Horizontal">
                  <Button Name="BtnOpenLogs" Content="Open log folder"/>
                  <Button Name="BtnOpenBackups" Content="Open backup folder"/>
                  <Button Name="BtnRefreshInfo" Content="Refresh"/>
                </StackPanel>
              </Border>
              <TextBox Name="InfoBox" IsReadOnly="True" Margin="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Text="collecting..."/>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <DockPanel Grid.Row="2" Background="#1E1E1E">
        <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,3">
          <DockPanel>
            <Button Name="BtnClearLog" Content="clear" DockPanel.Dock="Right" Padding="8,1" FontSize="11" Margin="0"/>
            <TextBlock Text="OUTPUT" Foreground="#858585" FontSize="11" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <TextBox Name="ConsoleBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" FontSize="12"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
